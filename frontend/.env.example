# ========================================
# 팀원용 설정 (마네킹 없이 개발)
# ========================================
# 이 파일을 .env로 복사해서 사용하세요:
# cp .env.example .env

# 데이터 모드: simulation (가짜 데이터 생성)
VITE_DATA_MODE=simulation

# 웹소켓 주소 (simulation 모드에서는 사용 안 됨)
VITE_WEBSOCKET_URL=ws://localhost:8765

# ========================================
# 마네킹이 있는 경우 (실제 센서 데이터)
# ========================================
# VITE_DATA_MODE=websocket
# VITE_WEBSOCKET_URL=ws://localhost:8765
