# LifePulse Frontend Environment Variables
# Copy this file to .env.local and fill in the values.

# WebSocket server URL (must match LIFEPULSE_PORT in backend/.env)
VITE_WEBSOCKET_URL=ws://localhost:8765

# REST API base URL (must match LIFEPULSE_API_PORT in backend/.env)
VITE_API_URL=http://localhost:8766

# Personal data retention period shown to participants (days).
# Should match your actual data retention policy.
VITE_DATA_RETENTION_DAYS=90
