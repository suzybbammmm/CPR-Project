# LifePulse Backend Environment Variables
# Copy this file to .env and fill in the values before running the server.
# Never commit .env to version control.

# ── WebSocket Server (ESP32 relay) ───────────────────────────────────────────
# Port the WebSocket server listens on. ESP32 connects here.
LIFEPULSE_PORT=8765
LIFEPULSE_HOST=0.0.0.0

# Set to "true" to generate fake sensor data (no ESP32 required).
LIFEPULSE_DEV_MODE=false

# ── REST API Server ──────────────────────────────────────────────────────────
# Port for the REST API (/api/v1/*). Defaults to 8766.
LIFEPULSE_API_PORT=8766

# CORS: set to your frontend origin. Default: http://localhost:5173
LIFEPULSE_CORS_ORIGIN=http://localhost:5173

# ── Admin Authentication ─────────────────────────────────────────────────────
# Admin password hash (scrypt). Generate with:
#   python3 -c "from auth_util import hash_password; print(hash_password('yourpassword'))"
# No default — admin page is disabled if this is not set.
LIFEPULSE_ADMIN_PASSWORD_HASH=

# Admin session TTL in hours. Default: 8
LIFEPULSE_SESSION_TTL_HOURS=8

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite database file path. Default: <backend-dir>/lifepulse.db
LIFEPULSE_DB_PATH=./lifepulse.db
